# C.H.A.O.S configuration. Copy to .env and fill in. NEVER commit .env.
# Secrets have no defaults on purpose: startup fails if they are missing.

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# --- Public hostname ---
# Used by the Caddy proxy for TLS. Leave as `localhost` for a laptop or LAN deployment and Caddy
# issues a certificate from its own local CA (your browser warns once). Set a real hostname and it
# obtains a Let's Encrypt certificate automatically.
CHAOS_HOSTNAME=localhost

# --- Database ---
POSTGRES_USER=chaos
POSTGRES_PASSWORD=
POSTGRES_DB=chaos

# DATABASE_URL is only needed when running the backend DIRECTLY (npm run dev) — docker compose
# composes it from POSTGRES_USER/PASSWORD/DB above, so you do not need to keep the two in sync.
# DATABASE_URL=postgres://chaos:your-password@localhost:5432/chaos

# --- Sessions ---
SESSION_COOKIE_NAME=chaos_session
SESSION_COOKIE_SECURE=true
SESSION_IDLE_MINUTES=30

# --- Domain configuration ---
CONTRACT_EXPIRY_WARN_DAYS=30

# --- Import ceilings (Unit 2) ---
# Both must be greater than zero; startup fails otherwise. Not secrets.
# The proxy enforces a slightly HIGHER body limit (6 MB) so that a just-over-limit upload still
# reaches the app and receives the message naming both limits.
# Excel is not supported in Phase 1 — CSV only. Save as .csv before uploading.
IMPORT_MAX_ROWS=2000
IMPORT_MAX_BYTES=5242880

# --- Password hashing (Argon2id) ---
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# --- First-run bootstrap. Remove INITIAL_ADMIN_PASSWORD after first start. ---
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
